rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// This security rules file assumes the following data structures:
//
// Collection: pedidos
// Document ID: {pedidoId} (Auto-generated by Cloud Firestore)
// Fields:
//   - clienteNombre: string (required, length 4..120, immutable on status update) - Nombre completo del cliente
//   - telefono: string (required, length == 10 digits, immutable on status update) - Teléfono de contacto (10 dígitos)
//   - direccion: string (required, length 10..250, immutable on status update) - Dirección completa de entrega
//   - restaurante: string (required, length 1..120, immutable on status update) - Nombre del restaurante
//   - platillo: string (required, length 1..150, immutable on status update) - Nombre del platillo ordenado
//   - precioUnitario: number (required, > 0 and <= 100000, immutable on status update) - Precio unitario del platillo
//   - cantidad: int (required, >= 1 and <= 20, immutable on status update) - Cantidad de órdenes
//   - costoEnvio: number (required, >= 0 and <= 10000, immutable on status update) - Costo de envío a domicilio
//   - total: number (required, > 0 and <= 250000, immutable on status update) - Monto total a pagar
//   - metodoPago: string (required, in ['Efectivo', 'Tarjeta en terminal', 'Transferencia SPEI'], immutable on status update) - Método de pago elegido
//   - notas: string (required, length 0..500, immutable on status update) - Instrucciones o notas adicionales
//   - estado: string (required, in ['En preparación', 'En camino', 'Entregado'], mutable) - Estado actual del pedido
//   - fechaCreacion: timestamp (required, immutable on status update) - Fecha y hora de creación del registro
//   - registradoPor: string (required, length 1..120, immutable on status update) - Autor del registro
//   - ultimaActualizacion: timestamp (optional on create, required/updated on status update) - Marca de tiempo de última actualización
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the user is authenticated (available for future Auth integration)
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user owns the resource (for user-owned documents)
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Verify UID hasn't been tampered with on create
    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == request.auth.uid;
    }

    // Ensure uid field is not modified on update
    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    // Validate required fields exist
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Validate that the document contains only the allowed fields
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // Validate string length
    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    // Validate optional timestamp field
    function isValidOptionalTimestamp(field) {
      return !(field in request.resource.data) ||
        request.resource.data[field] is timestamp;
    }

    // Validate that a numeric field is positive
    function isPositiveRange(field, maxVal) {
      return request.resource.data[field] is number &&
        request.resource.data[field] > 0 &&
        request.resource.data[field] <= maxVal;
    }

    // Validate that a numeric field is non-negative
    function isNonNegativeRange(field, maxVal) {
      return request.resource.data[field] is number &&
        request.resource.data[field] >= 0 &&
        request.resource.data[field] <= maxVal;
    }

    // Validate that immutable fields have not been modified during an update
    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // ===============================================================
    // Domain Validators (Used in BOTH create and update)
    // ===============================================================

    // Validates the complete schema and constraints of a Pedido document
    // Prevents empty records and enforces field types, ranges, and string length bounds.
    function isValidPedido(data) {
      let requiredFields = [
        'clienteNombre',
        'telefono',
        'direccion',
        'restaurante',
        'platillo',
        'precioUnitario',
        'cantidad',
        'costoEnvio',
        'total',
        'metodoPago',
        'notas',
        'estado',
        'fechaCreacion',
        'registradoPor'
      ];
      let allowedFields = [
        'clienteNombre',
        'telefono',
        'direccion',
        'restaurante',
        'platillo',
        'precioUnitario',
        'cantidad',
        'costoEnvio',
        'total',
        'metodoPago',
        'notas',
        'estado',
        'fechaCreacion',
        'registradoPor',
        'ultimaActualizacion'
      ];

      return hasRequiredFields(requiredFields) &&
        hasOnlyAllowedFields(allowedFields) &&
        validStringLength('clienteNombre', 4, 120) &&
        validStringLength('telefono', 10, 10) &&
        data.telefono.matches('^[0-9]{10}$') &&
        validStringLength('direccion', 10, 250) &&
        validStringLength('restaurante', 1, 120) &&
        validStringLength('platillo', 1, 150) &&
        isPositiveRange('precioUnitario', 100000) &&
        data.cantidad is int &&
        data.cantidad >= 1 &&
        data.cantidad <= 20 &&
        isNonNegativeRange('costoEnvio', 10000) &&
        isPositiveRange('total', 250000) &&
        validStringLength('metodoPago', 1, 50) &&
        data.metodoPago in ['Efectivo', 'Tarjeta en terminal', 'Transferencia SPEI'] &&
        validStringLength('notas', 0, 500) &&
        data.estado in ['En preparación', 'En camino', 'Entregado'] &&
        data.fechaCreacion is timestamp &&
        validStringLength('registradoPor', 1, 120) &&
        isValidOptionalTimestamp('ultimaActualizacion');
    }

    // Validates that an update only modifies 'estado' and optionally 'ultimaActualizacion'
    // while keeping all core order details immutable.
    function isValidPedidoUpdate() {
      let immutableFields = [
        'clienteNombre',
        'telefono',
        'direccion',
        'restaurante',
        'platillo',
        'precioUnitario',
        'cantidad',
        'costoEnvio',
        'total',
        'metodoPago',
        'notas',
        'fechaCreacion',
        'registradoPor'
      ];
      return areImmutableFieldsUnchanged(immutableFields) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'ultimaActualizacion']);
    }

    // ===============================================================
    // Collection Rules: /pedidos/{pedidoId}
    // ===============================================================
    match /pedidos/{pedidoId} {
      // Allow read access (get and list) for student/teacher project evaluation
      allow read: if true;

      // Allow creating new orders only if all required fields are present and valid
      allow create: if isValidPedido(request.resource.data);

      // Allow updating order status ('En preparación', 'En camino', 'Entregado')
      // while enforcing the full domain validator and protecting immutable order fields
      allow update: if isValidPedido(request.resource.data) && isValidPedidoUpdate();

      // Allow deleting order records for evaluation testing
      allow delete: if true;
    }

    // ===============================================================
    // Default Deny All Other Paths
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
